<?xml version="1.0"?>
<sdf version="1.9">
  <world name="amr_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Indoor-style lighting: strong ambient so surfaces facing away from the sun aren't black -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 8 x 8 m arena -->
    <model name="arena">
      <static>true</static>
      <link name="walls">
        <collision name="north_c"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1</size></box></geometry></collision>
        <visual name="north_v"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
        <collision name="east_c"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1</size></box></geometry></collision>
        <visual name="east_v"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
        <collision name="west_c"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1</size></box></geometry></collision>
        <visual name="west_v"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles -->
    <model name="box_1">
      <static>true</static>
      <pose>2 1 0.4 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-2 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.4 0.8</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>-1.5 1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>1.5 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Staircase against the south wall. The first step (15 cm) is below the lidar's
         scan plane (17.5 cm), so only the camera and YOLOv8 can see it coming. -->
    <model name="stairs">
      <static>true</static>
      <link name="link">
        <collision name="step0_c"><pose>0 -2.350 0.075 0 0 0</pose><geometry><box><size>1.2 0.3 0.150</size></box></geometry></collision>
        <visual name="step0_riser"><pose>0 -2.350 0.065 0 0 0</pose><geometry><box><size>1.2 0.3 0.130</size></box></geometry><material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse></material></visual>
        <visual name="step0_tread"><pose>0 -2.335 0.140 0 0 0</pose><geometry><box><size>1.22 0.330 0.02</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <collision name="step1_c"><pose>0 -2.650 0.150 0 0 0</pose><geometry><box><size>1.2 0.3 0.300</size></box></geometry></collision>
        <visual name="step1_riser"><pose>0 -2.650 0.140 0 0 0</pose><geometry><box><size>1.2 0.3 0.280</size></box></geometry><material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse></material></visual>
        <visual name="step1_tread"><pose>0 -2.635 0.290 0 0 0</pose><geometry><box><size>1.22 0.330 0.02</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <collision name="step2_c"><pose>0 -2.950 0.225 0 0 0</pose><geometry><box><size>1.2 0.3 0.450</size></box></geometry></collision>
        <visual name="step2_riser"><pose>0 -2.950 0.215 0 0 0</pose><geometry><box><size>1.2 0.3 0.430</size></box></geometry><material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse></material></visual>
        <visual name="step2_tread"><pose>0 -2.935 0.440 0 0 0</pose><geometry><box><size>1.22 0.330 0.02</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <collision name="step3_c"><pose>0 -3.250 0.300 0 0 0</pose><geometry><box><size>1.2 0.3 0.600</size></box></geometry></collision>
        <visual name="step3_riser"><pose>0 -3.250 0.290 0 0 0</pose><geometry><box><size>1.2 0.3 0.580</size></box></geometry><material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse></material></visual>
        <visual name="step3_tread"><pose>0 -3.235 0.590 0 0 0</pose><geometry><box><size>1.22 0.330 0.02</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <collision name="step4_c"><pose>0 -3.550 0.375 0 0 0</pose><geometry><box><size>1.2 0.3 0.750</size></box></geometry></collision>
        <visual name="step4_riser"><pose>0 -3.550 0.365 0 0 0</pose><geometry><box><size>1.2 0.3 0.730</size></box></geometry><material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse></material></visual>
        <visual name="step4_tread"><pose>0 -3.535 0.740 0 0 0</pose><geometry><box><size>1.22 0.330 0.02</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <collision name="step5_c"><pose>0 -3.850 0.450 0 0 0</pose><geometry><box><size>1.2 0.3 0.900</size></box></geometry></collision>
        <visual name="step5_riser"><pose>0 -3.850 0.440 0 0 0</pose><geometry><box><size>1.2 0.3 0.880</size></box></geometry><material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse></material></visual>
        <visual name="step5_tread"><pose>0 -3.835 0.890 0 0 0</pose><geometry><box><size>1.22 0.330 0.02</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <visual name="post_l0"><pose>0.630 -2.300 0.600 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_l1"><pose>0.630 -2.600 0.750 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_l2"><pose>0.630 -2.900 0.900 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_l3"><pose>0.630 -3.200 1.050 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_l4"><pose>0.630 -3.500 1.200 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_l5"><pose>0.630 -3.800 1.350 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="rail_l"><pose>0.630 -3.050 1.425 -0.4636 0 0</pose><geometry><box><size>0.04 1.977 0.04</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
        <visual name="post_r0"><pose>-0.630 -2.300 0.600 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_r1"><pose>-0.630 -2.600 0.750 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_r2"><pose>-0.630 -2.900 0.900 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_r3"><pose>-0.630 -3.200 1.050 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_r4"><pose>-0.630 -3.500 1.200 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="post_r5"><pose>-0.630 -3.800 1.350 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.9</length></cylinder></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="rail_r"><pose>-0.630 -3.050 1.425 -0.4636 0 0</pose><geometry><box><size>0.04 1.977 0.04</size></box></geometry><material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- The robot: 80 x 45 cm frame, 15 cm drive wheels (30 cm apart) 20 cm behind the front,
         two rear casters, lidar in the centre of the frame. base_link is the drive-axle midpoint.
         Matches amr_description/urdf/amr.urdf.xacro. -->
    <model name="amr">
      <!-- base_link sits on the drive axle, one wheel radius above the floor; the frame centre is 0.2 m behind it -->
      <pose>0 0 0.075 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>-0.2 0 0 0 0 0</pose>
          <mass>8.0</mass>
          <inertia><ixx>0.137</ixx><iyy>0.428</iyy><izz>0.562</izz></inertia>
        </inertial>
        <collision name="c"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.8 0.45 0.05</size></box></geometry></collision>
        <visual name="v"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.8 0.45 0.05</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
        <visual name="deck"><pose>-0.2 0 0.17 0 0 0</pose><geometry><box><size>0.8 0.5 0.01</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
        <!-- Forward-facing camera for the YOLOv8 hazard detector -->
        <sensor name="camera" type="camera">
          <pose>0.2 0 0.17 0 0.12 0</pose>
          <topic>camera/image_raw</topic>
          <gz_frame_id>camera_link</gz_frame_id>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.085</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.15 0 -1.5707 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.00077</ixx><iyy>0.00077</iyy><izz>0.0014</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <link name="right_wheel">
        <pose>0 -0.15 0 -1.5707 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.00077</ixx><iyy>0.00077</iyy><izz>0.0014</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rear_left_caster">
        <pose>-0.55 0.18 -0.0375 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.00006</ixx><iyy>0.00006</iyy><izz>0.00006</izz></inertia></inertial>
        <collision name="c">
          <geometry><sphere><radius>0.0375</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><sphere><radius>0.0375</radius></sphere></geometry>
          <material><ambient>0.95 0.45 0.1 1</ambient><diffuse>0.95 0.45 0.1 1</diffuse></material></visual>
      </link>
      <joint name="rear_left_caster_joint" type="fixed"><parent>base_link</parent><child>rear_left_caster</child></joint>
      <link name="rear_right_caster">
        <pose>-0.55 -0.18 -0.0375 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.00006</ixx><iyy>0.00006</iyy><izz>0.00006</izz></inertia></inertial>
        <collision name="c">
          <geometry><sphere><radius>0.0375</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><sphere><radius>0.0375</radius></sphere></geometry>
          <material><ambient>0.95 0.45 0.1 1</ambient><diffuse>0.95 0.45 0.1 1</diffuse></material></visual>
      </link>
      <joint name="rear_right_caster_joint" type="fixed"><parent>base_link</parent><child>rear_right_caster</child></joint>

      <link name="lidar_link">
        <pose>-0.2 0 0.10 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <topic>scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
      <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

      <!-- Wheel angles for robot_state_publisher, bridged to /joint_states -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.30</wheel_separation>
        <wheel_radius>0.075</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <max_linear_velocity>0.45</max_linear_velocity>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
